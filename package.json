    "@testing-library/react": "latest",
    "@testing-library/user-event": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "0.34.6",
    "jsdom": "^26.1.0",
    "playwright": "latest",
    "react-doctor": "latest",
    "react-grab": "latest",
